# Server-only, read-only RPC credentials. No wallet/private key is needed.
TRADES_RPC_URL=
# Optional JSON array of up to four previously verified RPC URLs, including
# the primary if desired. The API races complete same-chain snapshots.
TRADES_RPC_URLS=[]
TRADES_CHAIN_ID=97
TRADES_VAULT_ADDRESS=
# Optional verified deployment block. Zero scans the latest lookback window.
TRADES_START_BLOCK=0
TRADES_CONFIRMATIONS=3
TRADES_LOOKBACK_BLOCKS=2000
TRADES_LOG_PAGE_SIZE=500
TRADES_PORT=3115

# Signed, gas-free activity. The managed installer sets the future activation
# timestamp only once and preserves its history and policy across releases.
DAILY_ACTIVITY_FILE=/var/lib/globaldroptrade-api/daily-activity.json
DAILY_ACTIVITY_ORIGIN=https://globaldroptrade.com
DAILY_ACTIVITY_ACTIVATION_TIMESTAMP=
GLOBAL_AUTOMATION_PUBLIC_STATUS=/var/www/globaldroptrade/automation-data/activation.json

# Optional official US marketplace catalogs. Server-only credentials; never VITE_*.
# Amazon Creators API NA credential version 3.1 and approved US Associates tag.
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_PARTNER_TAG=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# In-memory daily request guard per provider. Use provider quotas for hard limits.
MARKETPLACE_DAILY_LIMIT=500
