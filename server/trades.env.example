# Server-only, read-only RPC credentials. No wallet/private key is needed.
TRADES_RPC_URL=
# Optional JSON array of up to four previously verified RPC URLs, including
# the primary if desired. The API races complete same-chain snapshots.
TRADES_RPC_URLS=[]
TRADES_CHAIN_ID=97
TRADES_VAULT_ADDRESS=
# Optional verified deployment block. Zero scans the latest lookback window.
TRADES_START_BLOCK=0
TRADES_CONFIRMATIONS=3
TRADES_LOOKBACK_BLOCKS=2000
TRADES_LOG_PAGE_SIZE=500
TRADES_PORT=3115

# Signed, gas-free activity. The managed installer sets the future activation
# timestamp only once and preserves its history and policy across releases.
DAILY_ACTIVITY_FILE=/var/lib/globaldroptrade-api/daily-activity.json
DAILY_ACTIVITY_ORIGIN=https://globaldroptrade.com
DAILY_ACTIVITY_ACTIVATION_TIMESTAMP=
GLOBAL_AUTOMATION_PUBLIC_STATUS=/var/www/globaldroptrade/automation-data/activation.json

# Optional official US marketplace catalogs. Server-only credentials; never VITE_*.
# Amazon Creators API NA credential version 3.1 and approved US Associates tag.
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_PARTNER_TAG=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Optional eBay seller account: user-consented, read-only fulfillment scope.
# Credentials are server-side only. Publishing aggregate order counts requires
# the separate explicit opt-in below; no individual order or buyer data is sent.
EBAY_SELLER_CLIENT_ID=
EBAY_SELLER_CLIENT_SECRET=
EBAY_SELLER_REFRESH_TOKEN=
EBAY_SELLER_PUBLIC_SUMMARY=0
# Additional opt-in for public 30-day aggregates by currency.
EBAY_SELLER_PUBLIC_PERFORMANCE=0
# Optional private JSON file with {version:1,orders:[...]}.
# Rows carry orderId, orderRevision (eBay lastModifiedDate), currency and decimal
# strings for gross, refunds, supplierCost, fees and otherCosts (e.g. remitted tax).
EBAY_SELLER_RECONCILIATION_FILE=
# In-memory daily request guard per provider. Use provider quotas for hard limits.
MARKETPLACE_DAILY_LIMIT=500

# Optional public activity from operator-owned accounts. These opt-ins publish
# side, gross amount/volume and time. Use dedicated read-only credentials.
# eBay uses the seller credentials above. Summary-only consent is independent.
EBAY_SELLER_PUBLIC_ACTIVITY=0
# Use the Business Purchase Reconciliation role, separate from catalog credentials.
AMAZON_BUSINESS_PUBLIC_ACTIVITY=0
AMAZON_BUSINESS_REGION=na
AMAZON_BUSINESS_CLIENT_ID=
AMAZON_BUSINESS_CLIENT_SECRET=
AMAZON_BUSINESS_REFRESH_TOKEN=
# Product details and per-order economics on the public dropshipping feed.
# Also requires the matching Amazon/eBay activity opt-in above.
DROPSHIPPING_PUBLIC_DETAILS=0
# Optional absolute path to a private JSON catalog used for exact matches:
# {"version":1,"products":[{"source":"amazon","id":"B000ABC123","model":"X2","type":"Headphones"}]}
# For eBay, id is legacyItemId; include variationId when the line has legacyVariationId.
# Optional name overrides the provider's listing title. Only name/model/type are published.
COMMERCE_PRODUCT_CATALOG_FILE=
# eBay net = gross - refunds - supplierCost - fees - otherCosts, using the
# matched EBAY_SELLER_RECONCILIATION_FILE above; Amazon charges show purchase totals.
# Kraken needs only permission to query closed orders and trades.
KRAKEN_PUBLIC_ACCOUNT_ACTIVITY=0
KRAKEN_ACTIVITY_KEY=
KRAKEN_ACTIVITY_SECRET=
